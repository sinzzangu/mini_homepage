# 이 파일을 .env로 복사하고 값을 채운다. .env는 커밋하지 않는다.
# 서버에서는 스택 루트(../.env)에 두고 compose의 env_file로 주입한다.

# python -c "import secrets; print(secrets.token_urlsafe(50))" 등으로 생성.
# 한 번 정하면 바꾸지 말 것 — 바꾸면 로그인 세션이 전부 끊긴다.
DJANGO_SECRET_KEY=

# Postgres 컨테이너 초기화에도 쓰이는 값.
# 처음 기동할 때 이 값으로 DB와 계정이 만들어진다.
POSTGRES_DB=changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# 컨테이너 밖(로컬 개발 등)에서 돌릴 때만 필요. 기본값은 compose 서비스명 db.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- 도메인 ---
# 셋 다 없어도 되고, 없으면 기존 운영 도메인이 기본값으로 쓰인다.
# ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS / CALENDAR_HOSTS 가 여기서 파생된다.
# localhost 와 127.0.0.1 은 내부 검증용이라 항상 자동으로 포함된다.
#
# 값은 `호스트명` 또는 `호스트명:포트` 만 적는다.
# 스킴이나 경로(`https://example.com`, `example.com/cal`)를 넣으면
# 부팅 시 ImproperlyConfigured 로 죽는다 — 조용히 전 요청 400 이 나는 것보다 낫다.
# 포트를 붙이면 ALLOWED_HOSTS 에는 호스트만, CSRF 신뢰 오리진에는 포트까지 들어간다.
#
# 메인 도메인. Caddy가 이 이름으로 TLS를 받는다.
# 쉼표로 여러 개 적으면 전부 허용되고, 첫 번째가 cal.<SITE_DOMAIN> 기본값의 기준이 된다.
# SITE_DOMAIN=example.com
#
# 캘린더 서브도메인. 이 Host로 들어오면 캘린더가 루트에 올라간 URLconf를 쓴다
# (calendars/middleware.py). 비워 두면 cal.<SITE_DOMAIN>.
# 쉼표로 여러 개도 가능하다.
# CALENDAR_DOMAIN=cal.example.com
#
# 그 밖에 접속을 허용할 호스트(쉼표 구분). CSRF 신뢰 오리진에도 https:// 로 함께 들어간다.
# EXTRA_ALLOWED_HOSTS=www.example.com,old.example.com
