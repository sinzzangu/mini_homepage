# 이 파일을 .env로 복사하고 값을 채운다. .env는 커밋하지 않는다.
# 서버에서는 스택 루트(../.env)에 두고 compose의 env_file로 주입한다.

# python -c "import secrets; print(secrets.token_urlsafe(50))" 등으로 생성.
# 한 번 정하면 바꾸지 말 것 — 바꾸면 로그인 세션이 전부 끊긴다.
DJANGO_SECRET_KEY=

# Postgres 컨테이너 초기화에도 쓰이는 값.
# 처음 기동할 때 이 값으로 DB와 계정이 만들어진다.
POSTGRES_DB=changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# 컨테이너 밖(로컬 개발 등)에서 돌릴 때만 필요. 기본값은 compose 서비스명 db.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
